# apps/web environment variables — placeholders only. Never commit real values
# (same convention as the root .env.example). Copy this file to
# apps/web/.env.local for local dev; Next.js loads .env.local automatically
# and it is already covered by the root .gitignore (".env.*", "!.env.example").
#
# See docs/30-engineering/DEVELOPER_COMMANDS.md ("Environment setup") for
# where to obtain each key and how local dev picks these up.
#
# Every third-party credential below is server-side only, per
# ARCHITECTURE.md's trust-boundary rules (NFR-003/AC-012/AC-018): content/UI
# code never talks to these providers directly, only apps/web's Route
# Handlers do. None of these should ever appear in a client bundle, a log
# line, or a committed file.

# Public site URL. Used for absolute URLs (OG tags, sitemap, RSS) and as the
# expected origin during local dev. Safe to expose to the client (NEXT_PUBLIC_).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Contact action group (FR-002/FR-004, T-016) ---

# Calendly scheduling link shown in the "Book a call" CTA. Safe to expose to
# the client (NEXT_PUBLIC_) — it's a public booking page URL, not a secret.
# No real link has been provided yet; the component falls back to a clearly
# marked placeholder (see apps/web/src/components/contact-actions/constants.ts)
# if this is unset. Set to Gaurav's real Calendly URL before launch.
NEXT_PUBLIC_CALENDLY_URL=

# --- Supabase — the single backend datastore (contact submissions, agent
# session metadata, transient conversation history). See ARCHITECTURE.md
# "Data ownership" and docs/30-engineering/DATA_MODEL.md. ---

# Project URL, e.g. https://xxxxxxxxxxxx.supabase.co
# Get it from: Supabase dashboard > Project Settings > API > Project URL.
SUPABASE_URL=

# Public anon key. This app does not use it client-side today — content/UI
# code never talks to Supabase directly, only via Route Handlers
# (ARCHITECTURE.md "Module boundaries") — but it's included for parity with
# the root .env.example and in case a future read-only, RLS-scoped use case
# needs it. Get it from: Supabase dashboard > Project Settings > API > anon/public key.
SUPABASE_ANON_KEY=

# Service-role key. Full read/write, bypasses Row Level Security. Server-side
# only — used exclusively by Route Handlers (/api/contact, /api/agent/*).
# Never expose to the client bundle, never log, never commit (NFR-003, AC-012).
# Get it from: Supabase dashboard > Project Settings > API > service_role key
# (marked "secret" — treat with the same care as any other root credential).
SUPABASE_SERVICE_ROLE_KEY=

# --- Voice/text agent pipeline (FR-013) — DIY Deepgram (STT) + Claude Haiku
# (LLM) + ElevenLabs (TTS), per ADR-001 (amended). All three keys below are
# server-side only; the browser only ever receives short-lived tokens minted
# by /api/agent/session, never these keys themselves. ---

# Speech-to-text. Used only by /api/agent/session (T-031) to mint a
# short-lived temporary token for the browser's direct Deepgram streaming-STT
# WebSocket connection — this key itself never reaches the browser.
# Get it from: Deepgram console (console.deepgram.com) > API Keys.
DEEPGRAM_API_KEY=

# Text-to-speech ONLY — scope this key to the TTS product, not the Agents
# Platform / Conversational AI product (ADR-001 D2, amended, chose plain TTS
# over the Agents Platform). Used only by /api/agent/session (T-031) to mint
# a short-lived single-use token for the browser's direct ElevenLabs TTS
# WebSocket connection.
# Get it from: ElevenLabs dashboard > Profile > API Keys. If the dashboard
# offers key scoping/permissions, restrict this key to Text-to-Speech only
# (least privilege, .claude/rules/security.md) — it should not be able to
# create/manage Agents Platform resources.
ELEVENLABS_API_KEY=

# Claude Haiku via the Anthropic Messages API — the conversational "brain",
# called only from /api/agent/turn (T-032), the one mandatory
# server-mediated hop. The Messages API has no ephemeral/client-token
# mechanism (ADR-001 D3, amended), so this key can never leave the server —
# structurally, not just by convention.
# Get it from: console.anthropic.com > Settings > API Keys.
ANTHROPIC_API_KEY=

# --- Contact form (FR-003) ---

# Outbound email delivery for contact-form notifications to Gaurav. Used only
# by /api/contact (T-020), after a submission is already durably recorded in
# Supabase (so a Resend failure never loses the submission).
# Get it from: Resend dashboard (resend.com) > API Keys.
RESEND_API_KEY=
